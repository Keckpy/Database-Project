{{#if deleteSuccess}}
<p class="success-message">The SpecimenTest was deleted. Use the RESET button on the homepage to restore it.</p>
{{/if}}

{{! READ table }}
<table>
    <thead>
        
        <tr>
            {{#each specimenTests.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        
        {{#each specimenTests}}
        <tr>
            <td>{{this.specimenTestID}}</td>
            <td>{{this.specimenID}}</td>
            <td>{{this.patient}}</td>
            <td>{{this.specimenType}}</td>
            <td>{{this.test}}</td>
            <td>{{this.doctor}}</td>
            <td>{{this.status}}</td>
            
            <td>
                {{! DELETE form }}
                <form class="inline-form" method="POST"
                      action="/specimenTests/delete/{{this.specimenTestID}}"
                      onsubmit="return confirm('Delete this SpecimenTest?');">
                    <button type="submit">Delete</button>
                </form>
            </td>
            
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Add a SpecimenTest</h2>
{{!-- <p>Specimen: [dropdown] Laboratory Test: [dropdown] Doctor: [dropdown] Status: [dropdown]</p> --}}
<form class="cuForm" id="add_specimenTest">
    <div>
    <label for="update_specimen">Specimen: </label>
    <select name="update_specimen" id="update_specimen" required>
        <option value="" disabled selected>Select a Specimen</option>
        {{#each specimens}}
            <option value="{{this.specimenID}}" required>
                {{this.specimenID}} - {{this.patient}} - {{this.specimenType}}
            </option>
        {{/each}}
    </select>
    </div>

    <div>
    <label for="update_laboratory_test">Laboratory Test: </label>
    <select name="update_laboratory_test" id="update_laboratory_test" required>
        <option value="" disabled selected>Select a Test</option>
        {{#each laboratoryTests}}
            <option value="{{this.laboratoryTestID}}" required>
                {{this.testName}}
            </option>
        {{/each}}
    </select>
    </div>

    <div>
    <label for="update_doctor">Doctor: </label>
    <select name="update_doctor" id="update_doctor" required>
        <option value="" disabled selected>Select a Doctor</option>
        {{#each doctors}}
            <option value="{{this.doctorID}}" required>
                {{this.doctorName}}
            </option>
        {{/each}}
    </select>
    </div>

    <div>
    <label for="update_status">Status: </label>
    <select name="update_status" id="update_status" required>
        <option value="" disabled selected>Select a Status</option>
        <option value="Collected">Ordered</option>
        <option value="In-Lab">In-Lab</option>
        <option value="Completed">Completed</option>
    </select>
    </div>
    
    <button type="submit">Add</button>
</form>


{{! UPDATE form }}
<h2>Update a SpecimenTest</h2>
{{!-- <p>Specimen: [dropdown] Laboratory Test: [dropdown] Doctor: [dropdown] Status: [dropdown]</p> --}}
<form class="cuForm" id="update_specimenTest">
    <div>
        <label for="update_specimenTest">SpecimenTest to Update: </label>
        <select name="update_specimenTest" id="update_specimenTest" required>
            <option value="" disabled selected>Select a SpecimenTest</option>
            {{#each specimenTests}}
            <option value="{{this.specimenTestID}}" required>
                {{this.specimenTestID}} - {{this.patient}} - {{this.test}}
            </option>
            {{/each}}
        </select>
    </div>

    <div>
        <label for="update_laboratory_test">Laboratory Test: </label>
        <select name="update_laboratory_test" id="update_laboratory_test" required>
            <option value="" disabled selected>Select a Test</option>
            {{#each laboratoryTests}}
                <option value="{{this.laboratoryTestID}}" required>
                    {{this.testName}}
                </option>
            {{/each}}
        </select>
    </div>

    <div>
        <label for="update_doctor">Doctor: </label>
        <select name="update_doctor" id="update_doctor" required>
            <option value="" disabled selected>Select a Doctor</option>
            {{#each doctors}}
                <option value="{{this.doctorID}}" required>
                    {{this.doctorName}}
                </option>
            {{/each}}
        </select>
    </div>

    <div>
        <label for="update_status">Status: </label>
        <select name="update_status" id="update_status" required>
            <option value="" disabled selected>Select a Status</option>
            <option value="Collected">Ordered</option>
            <option value="In-Lab">In-Lab</option>
            <option value="Completed">Completed</option>
        </select>
    </div>

    <button type="submit">Update</button>
</form>
