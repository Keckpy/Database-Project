{{#if deleteSuccess}}
<p class="success-message">The SpecimenTest was deleted. Use the RESET button on the homepage to restore it.</p>
{{/if}}

{{#if updateSuccess}}
<p class="success-message">The SpecimenTest was updated successfully.</p>
{{/if}}

{{! READ table }}
<table>
    <thead>
        
        <tr>
            {{#each specimenTests.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        
        {{#each specimenTests}}
        <tr>
            <td>{{this.specimenTestID}}</td>
            <td>{{this.specimenID}}</td>
            <td>{{this.patient}}</td>
            <td>{{this.specimenType}}</td>
            <td>{{this.test}}</td>
            <td>{{this.doctor}}</td>
            <td>{{this.status}}</td>
            
            <td>
                {{! DELETE form }}
                <form class="inline-form" method="POST"
                      action="/specimenTests/delete/{{this.specimenTestID}}"
                      onsubmit="return confirm('Delete this SpecimenTest?');">
                    <button type="submit">Delete</button>
                </form>
            </td>
            
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Add a SpecimenTest</h2>
<form class="cuForm" id="add-specimenTest-form" method="POST" action="/specimenTests/add">
    <div>
    <label for="add-specimenID">Specimen: </label>
    <select id="add-specimenID" name="specimenID"  required>
        <option value="" disabled selected>Select a Specimen</option>
        {{#each specimens}}
            <option value="{{this.specimenID}}" required>
                {{this.specimenID}} - {{this.patient}} - {{this.specimenType}}
            </option>
        {{/each}}
    </select>
    </div>

    <div>
    <label for="add-laboratory-test">Laboratory Test: </label>
    <select id="add-laboratory-test" name="laboratoryTestID"  required>
        <option value="" disabled selected>Select a Test</option>
        {{#each laboratoryTests}}
            <option value="{{this.laboratoryTestID}}" required>
                {{this.testName}}
            </option>
        {{/each}}
    </select>
    </div>

    <div>
    <label for="add-doctor">Doctor: </label>
    <select id="add-doctor" name="doctorID"  required>
        <option value="" disabled selected>Select a Doctor</option>
        {{#each doctors}}
            <option value="{{this.doctorID}}" required>
                {{this.doctorName}}
            </option>
        {{/each}}
    </select>
    </div>

    <div>
    <label for="add-status">Status: </label>
    <select id="add-status" name="status"  required>
        <option value="" disabled selected>Select a Status</option>
        <option value="Ordered">Ordered</option>
        <option value="In-Lab">In-Lab</option>
        <option value="Completed">Completed</option>
    </select>
    </div>
    
    <button type="submit">Add</button>
</form>


{{! UPDATE form }}
<h2>Update a SpecimenTest</h2>
{{!-- <p>Specimen: [dropdown] Laboratory Test: [dropdown] Doctor: [dropdown] Status: [dropdown]</p> --}}
{{!--
AI Use Citation:
Date: 08/12/2026
Scope: ChatGPT helped connect this existing UPDATE form to the Express route and
standardize the field names used by the SpecimenTests update stored procedure.
Originality: Reviewed and adapted to the group's existing Handlebars page.
Source: https://chatgpt.com/
--}}
<form class="cuForm" id="update-specimenTest-form" method="POST" action="/specimenTests/update">
    <div>
        <label for="update-specimenTestID">SpecimenTest to Update: </label>
        <select name="specimenTestID" id="update-specimenTestID" required>
            <option value="" disabled selected>Select a SpecimenTest</option>
            {{#each specimenTests}}
            <option value="{{this.specimenTestID}}" required>
                {{this.specimenTestID}} - {{this.patient}} - {{this.test}}
            </option>
            {{/each}}
        </select>
    </div>

    <div>
        <label for="update-laboratoryTestID">Laboratory Test: </label>
        <select name="laboratoryTestID" id="update-laboratoryTestID" required>
            <option value="" disabled selected>Select a Test</option>
            {{#each laboratoryTests}}
                <option value="{{this.laboratoryTestID}}" required>
                    {{this.testName}}
                </option>
            {{/each}}
        </select>
    </div>

    <div>
        <label for="update-doctorID">Doctor: </label>
        <select name="doctorID" id="update-doctorID" required>
            <option value="" disabled selected>Select a Doctor</option>
            {{#each doctors}}
                <option value="{{this.doctorID}}" required>
                    {{this.doctorName}}
                </option>
            {{/each}}
        </select>
    </div>

    <div>
        <label for="update-testStatus">Status: </label>
        <select name="testStatus" id="update-testStatus" required>
            <option value="" disabled selected>Select a Status</option>
            <option value="Ordered">Ordered</option>
            <option value="In-Lab">In-Lab</option>
            <option value="Completed">Completed</option>
        </select>
    </div>

    <button type="submit">Update</button>
</form>
