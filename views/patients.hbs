<h1>Patients</h1>

<nav>
    <a href="/">Home</a> |
    <a href="/patients">Patients</a> |
    <a href="/doctors">Doctors</a> |
    <a href="/specimens">Specimens</a> |
    <a href="/laboratoryTests">LaboratoryTests</a> |
    <a href="/specimenTests">SpecimenTests</a>
</nav>

<br>

<table>
    <thead>
        <tr>
            <th>patientID</th>
            <th>firstName</th>
            <th>lastName</th>
            <th>dateOfBirth</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>
        {{#each patients}}
        <tr>
            <td>{{this.patientID}}</td>
            <td>{{this.firstName}}</td>
            <td>{{this.lastName}}</td>
            <td>{{this.dateOfBirth}}</td>
            <td>
                <button type="button">Delete</button>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

<h2>Add a Patient</h2>

<form>
    <label for="add-firstName">First Name:</label>
    <input
        type="text"
        id="add-firstName"
        name="firstName"
        required
    >

    <br><br>

    <label for="add-lastName">Last Name:</label>
    <input
        type="text"
        id="add-lastName"
        name="lastName"
        required
    >

    <br><br>

    <label for="add-dateOfBirth">Date of Birth:</label>
    <input
        type="date"
        id="add-dateOfBirth"
        name="dateOfBirth"
        required
    >

    <br><br>

    <button type="submit">Add Patient</button>
</form>

<h2>Update a Patient</h2>

<form>
    <label for="update-patientID">Patient to Update:</label>
    <select id="update-patientID" name="patientID" required>
        <option value="">Select a Patient</option>

        {{#each patients}}
        <option value="{{this.patientID}}">
            {{this.patientID}} - {{this.firstName}} {{this.lastName}}
        </option>
        {{/each}}
    </select>

    <br><br>

    <label for="update-firstName">First Name:</label>
    <input
        type="text"
        id="update-firstName"
        name="firstName"
        required
    >

    <br><br>

    <label for="update-lastName">Last Name:</label>
    <input
        type="text"
        id="update-lastName"
        name="lastName"
        required
    >

    <br><br>

    <label for="update-dateOfBirth">Date of Birth:</label>
    <input
        type="date"
        id="update-dateOfBirth"
        name="dateOfBirth"
        required
    >

    <br><br>

    <button type="submit">Update Patient</button>
</form>
