<section class="reset-panel">
    <h2>RESET Demonstration</h2>
    <p>
        Delete a row on the SpecimenTests page, then use this button to recreate
        the schema and restore all five sample SpecimenTests records.
    </p>
    <form method="POST" action="/reset-database"
          onsubmit="return confirm('Reset the entire database and restore the sample data?');">
        <button class="reset-button" type="submit">RESET Database</button>
    </form>
</section>
