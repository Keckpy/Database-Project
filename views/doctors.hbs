<table>
    <thead>
        <tr>
            <th>doctorID</th>
            <th>firstName</th>
            <th>lastName</th>
            <th>specialty</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>
        {{#each doctors}}
        <tr>
            <td>{{this.doctorID}}</td>
            <td>{{this.firstName}}</td>
            <td>{{this.lastName}}</td>
            <td>{{this.specialty}}</td>
            <td>
                <button type="button">Delete</button>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

<br>

<h2>Add a Doctor</h2>

<form>
    <label for="add-firstName">First Name:</label>
    <input
        type="text"
        id="add-firstName"
        name="firstName"
        required
    >

    <br><br>

    <label for="add-lastName">Last Name:</label>
    <input
        type="text"
        id="add-lastName"
        name="lastName"
        required
    >

    <br><br>

    <label for="add-specialty">Specialty:</label>
    <input
        type="text"
        id="add-specialty"
        name="specialty"
        required
    >

    <br><br>

    <button type="submit">Add Doctor</button>
</form>

<br>

<h2>Update a Doctor</h2>

<form>
    <label for="update-doctorID">Doctor to Update:</label>

    <select id="update-doctorID" name="doctorID" required>
        <option value="">Select a Doctor</option>

        {{#each doctors}}
        <option value="{{this.doctorID}}">
            {{this.doctorID}} - {{this.firstName}} {{this.lastName}}
        </option>
        {{/each}}
    </select>

    <br><br>

    <label for="update-firstName">First Name:</label>
    <input
        type="text"
        id="update-firstName"
        name="firstName"
        required
    >

    <br><br>

    <label for="update-lastName">Last Name:</label>
    <input
        type="text"
        id="update-lastName"
        name="lastName"
        required
    >

    <br><br>

    <label for="update-specialty">Specialty:</label>
    <input
        type="text"
        id="update-specialty"
        name="specialty"
        required
    >

    <br><br>

    <button type="submit">Update Doctor</button>
</form>