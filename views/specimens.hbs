<table>
    <thead>
        <tr>
            <th>specimenID</th>
            <th>patient</th>
            <th>specimenType</th>
            <th>status</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>
        {{#each specimens}}
        <tr>
            <td>{{this.specimenID}}</td>
            <td>{{this.patient}}</td>
            <td>{{this.specimenType}}</td>
            <td>{{this.status}}</td>
            <td>
                <form action="">
                    <button type="button">Delete</button>
                </form>
                
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

<br>

<h2>Add a Specimen</h2>

<form class="cuForm" id="add-specimen-form" method="POST" action="/specimens/add">
    <label for="add-patientID">Patient:</label>

    <select id="add-patientID" name="patientID" required>
        <option value="">Select a Patient</option>

        {{#each patients}}
        <option value="{{this.patientID}}">
            {{this.patientID}} - {{this.firstName}} {{this.lastName}}
        </option>
        {{/each}}
    </select>

    <br><br>

    <label for="add-specimenType">Specimen Type:</label>
    <select id="add-specimenType" name="specimenType" required>
        <option value="">Select a Specimen Type</option>
        <option value="SST">SST</option>
        <option value="EDTA">EDTA</option>
        <option value="Sodium Citrate">Sodium Citrate</option>
        <option value="Lithium Heparin">Lithium Heparin</option>
    </select>

    <br><br>

    <label for="add-status">Status:</label>

    <select id="add-status" name="status" required>
        <option value="">Select a Status</option>
        <option value="Collected">Collected</option>
        <option value="Received">Received</option>
        <option value="Processing">Processing</option>
        <option value="Completed">Completed</option>
    </select>

    <br><br>

    <button type="submit">Add Specimen</button>
</form>

<br>

<h2>Update a Specimen</h2>

<form class="cuForm">
    <label for="update-specimenID">Specimen to Update:</label>

    <select id="update-specimenID" name="specimenID" required>
        <option value="">Select a Specimen</option>

        {{#each specimens}}
        <option value="{{this.specimenID}}">
            {{this.specimenID}} - {{this.patient}}
        </option>
        {{/each}}
    </select>

    <br><br>
    
    <label for="add-specimenType">Specimen Type:</label>
    <select id="add-specimenType" name="specimenType" required>
        <option value="">Select a Specimen Type</option>
        <option value="SST">SST</option>
        <option value="EDTA">EDTA</option>
        <option value="Sodium Citrate">Sodium Citrate</option>
        <option value="Lithium Heparin">Lithium Heparin</option>
    </select>

    <br><br>

    <label for="update-status">Status:</label>

    <select id="update-status" name="status" required>
        <option value="">Select a Status</option>
        <option value="Collected">Collected</option>
        <option value="Received">Received</option>
        <option value="Processing">Processing</option>
        <option value="Completed">Completed</option>
    </select>

    <br><br>

    <button type="submit">Update Specimen</button>
</form>